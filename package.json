{
  "name": "mqtt-thing",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "workspaces": ["packages/*", "services/*", "tools/*"],
  "scripts": {
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "typecheck": "tsc",
    "test": "vitest run --exclude '**/*.integration.test.ts'",
    "test:integration": "vitest run integration",
    "migrate": "node-pg-migrate --envPath .env up",
    "migrate:down": "node-pg-migrate --envPath .env down",
    "migrate:redo": "node-pg-migrate --envPath .env redo",
    "migrate:create": "node-pg-migrate --envPath .env create -j ts"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.13",
    "@testcontainers/postgresql": "^12.1.0",
    "@types/node": "^24.13.4",
    "dotenv": "^17.4.2",
    "lefthook": "^2.1.14",
    "node-pg-migrate": "^9.0.0",
    "typescript": "^7.0.2",
    "vitest": "^5.0.0"
  }
}
